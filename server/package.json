{
  "name": "movie-tracker-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "worker": "node --env-file-if-exists=.env src/workers/posterWorker.js",
    "start:combined": "concurrently --kill-others --names api,worker \"node --env-file-if-exists=.env src/server.js\" \"node --env-file-if-exists=.env src/workers/posterWorker.js\"",
    "queue:test": "node --env-file=.env src/scripts/testQueue.js",
    "storage:test": "node --env-file=.env src/scripts/testStorage.js",
    "posters:backfill": "node --env-file=.env src/scripts/backfillPosters.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "bullmq": "^5.81.5",
    "concurrently": "^10.0.6",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "mongoose": "^8.19.0",
    "multer": "^2.4.0",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  }
}
